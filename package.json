{
  "name": "npm-package-sclatch",
  "version": "1.0.1",
  "description": "first npm package",
  "keywords": [
    "demo",
    "typescript"
  ],
  "scripts": {
    "build": "tsc",
    "ci": "npm run build && npm run check-format && npm run test",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "test": "vitest run",
    "dev": "vitest",
    "local-release": "changeset version && changeset publish",
    "prepublishOnly": "npm run ci"
  },
  "homepage": "https://github.com/sclatch1/npm-packag",
  "bugs": {
    "url": "https://github.com/sclatch1/npm-package/issues"
  },
  "author": "david scalais <david.scalais@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sclatch1/npm-package.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
